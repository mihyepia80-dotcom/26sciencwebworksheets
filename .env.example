# Vercel 환경 변수 목록 (참고용)
# 값은 Vercel Dashboard → Settings → Environment Variables 에만 입력합니다.
# .env / .env.local 파일은 사용하지 않습니다.

# Firebase Client (NEXT_PUBLIC_* — 브라우저 노출)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (서버 전용 — 학생 로그인·AI 사용량 집계)
# Firebase Console 서비스 계정 JSON을 한 줄로 붙여넣기
FIREBASE_SERVICE_ACCOUNT_JSON=

# 학생 Firebase Auth 내부 비밀번호 (서버 전용)
STUDENT_AUTH_SECRET=

# Gemini AI (서버 전용 — 플랫폼 관리자 전용 fallback)
GEMINI_API_KEY=
GEMINI_DAILY_LIMIT=100

# 플랫폼 관리자 (공용 API 키 사용 권한 — 쉼표 구분 UID 또는 이메일)
ADMIN_UIDS=
ADMIN_EMAILS=

# Padlet API (서버 전용 — 플랫폼 관리자 전용 fallback)
# Padlet Developer 설정에서 발급 (유료 계정)
PADLET_API_KEY=
# 선택: 기본 워크스페이스·역할
PADLET_DEFAULT_WORKSPACE_ID=
PADLET_DEFAULT_ROLE=초등 과학 교사
