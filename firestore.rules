rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function teacherDomainEmail(email) {
      return email is string && email.matches('(?i).*@sagodogu-teacher\\.app$');
    }

    function isTeacher() {
      return request.auth != null && teacherDomainEmail(request.auth.token.email);
    }

    function isStudent() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i).*@sagodogu-student\\.app$');
    }

    function hasTeacherProfile(teacherId) {
      return exists(/databases/$(database)/documents/teachers/$(teacherId));
    }

    function isTeacherAt(teacherId) {
      return request.auth != null
        && request.auth.uid == teacherId
        && (
          isTeacher()
          || (
            hasTeacherProfile(teacherId)
            && teacherDomainEmail(
              get(/databases/$(database)/documents/teachers/$(teacherId)).data.get('email', '')
            )
          )
        );
    }

    function canCreateTeacherProfile(teacherId) {
      return request.auth != null
        && request.auth.uid == teacherId
        && !isStudent()
        && teacherDomainEmail(request.resource.data.get('email', ''));
    }

    /** 교사 본인 데이터 — 학생 계정 제외, uid 일치 */
    function ownsTeacherScope(teacherId) {
      return request.auth != null
        && request.auth.uid == teacherId
        && !isStudent();
    }

    function studentData(uid) {
      return get(/databases/$(database)/documents/students/$(uid)).data;
    }

    function isSameClass(studentUid) {
      return studentData(request.auth.uid).grade == studentData(studentUid).grade
        && studentData(request.auth.uid).classNo == studentData(studentUid).classNo;
    }

    function isValidPeerFeedback(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'targetUid', 'targetName', 'grade', 'classNo',
          'targetType', 'targetDocId', 'templateId', 'templateName',
          'differentPoint', 'goodPoint', 'curiousPoint'
        ])
        && data.authorUid is string
        && data.targetUid is string
        && data.authorUid == request.auth.uid
        && data.targetUid != request.auth.uid
        && data.targetType in ['worksheet', 'inquiry-report']
        && data.differentPoint is string && data.differentPoint.size() <= 2000
        && data.goodPoint is string && data.goodPoint.size() <= 2000
        && data.curiousPoint is string && data.curiousPoint.size() <= 2000
        && isSameClass(data.targetUid)
        && data.grade == studentData(request.auth.uid).grade
        && data.classNo == studentData(request.auth.uid).classNo;
    }

    function isValidSubmissionData(data) {
      return data.keys().hasAll(['templateId', 'templateName', 'meta', 'values', 'studentUid', 'status', 'updatedAt'])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 64
        && data.templateName is string
        && data.templateName.size() <= 120
        && data.meta is map
        && data.meta.size() <= 20
        && data.values is map
        && data.values.size() <= 200
        && data.studentUid is string
        && data.status in ['draft', 'submitted']
        && (
          (data.status == 'draft' && data.submittedAt == null)
          || (data.status == 'submitted' && data.submittedAt is timestamp)
        )
        && (!('aiFeedback' in data) || (data.aiFeedback is string && data.aiFeedback.size() <= 300))
        && (!('aiRating' in data) || data.aiRating in ['잘함', '보통', '노력요함']);
    }

    function isValidSubmissionCreate(data) {
      return isValidSubmissionData(data)
        && data.studentUid == request.auth.uid
        && data.updatedAt == request.time
        && (
          (data.status == 'draft' && data.submittedAt == null)
          || (data.status == 'submitted' && data.submittedAt == request.time)
        );
    }

    function isValidSubmissionUpdate() {
      return isValidSubmissionData(request.resource.data)
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'draft' && request.resource.data.submittedAt == null)
          || (request.resource.data.status == 'submitted' && request.resource.data.submittedAt == request.time)
        );
    }

    function isValidShareData(data) {
      return data.keys().hasAll(['submissionId', 'studentUid', 'templateId', 'templateName', 'meta', 'values'])
        && data.submissionId is string
        && data.studentUid is string
        && data.templateId is string
        && data.templateName is string
        && data.meta is map
        && data.values is map;
    }

    function isValidShareUpdate() {
      return isValidShareData(request.resource.data)
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.submissionId == resource.data.submissionId;
    }

    match /teachers/{teacherId} {
      allow read: if request.auth != null && request.auth.uid == teacherId;
      allow create: if canCreateTeacherProfile(teacherId);
      allow update: if ownsTeacherScope(teacherId) || isTeacherAt(teacherId);

      match /classRosters/{rosterId} {
        allow read, write: if ownsTeacherScope(teacherId);
      }

      match /groupRosterStudents/{studentId} {
        allow read, write: if ownsTeacherScope(teacherId);
      }

      match /groupSeparations/{ruleId} {
        allow read, write: if ownsTeacherScope(teacherId);
      }

      match /groupAssignments/{assignmentId} {
        allow read, write: if ownsTeacherScope(teacherId);
      }

      match /groupActivityPraises/{praiseId} {
        allow read, write: if ownsTeacherScope(teacherId);
      }
    }

    match /students/{uid} {
      allow read: if isTeacher()
        || request.auth.uid == uid
        || (isStudent() && isSameClass(uid));
      allow create, update: if request.auth != null && request.auth.uid == uid && isStudent();
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow create: if isStudent() && isValidSubmissionCreate(request.resource.data);
      allow read: if isTeacher()
        || (request.auth != null && resource.data.studentUid == request.auth.uid)
        || (isStudent()
          && resource.data.studentUid != request.auth.uid
          && isSameClass(resource.data.studentUid));
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && isValidSubmissionUpdate();
      allow delete: if isTeacher();
    }

    match /shares/{shareId} {
      allow read: if true;
      allow create: if isStudent()
        && isValidShareData(request.resource.data)
        && request.resource.data.studentUid == request.auth.uid;
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && isValidShareUpdate();
      allow delete: if isTeacher();
    }

    match /apiQuota/{docId} {
      allow read, write: if false;

      match /students/{studentUid} {
        allow read, write: if false;
      }
    }

    match /inquiryReports/{reportId} {
      allow create: if isStudent()
        && request.resource.data.studentUid == request.auth.uid;
      allow read: if isTeacher()
        || (request.auth != null && resource.data.studentUid == request.auth.uid)
        || (isStudent()
          && resource.data.status == 'submitted'
          && resource.data.studentUid != request.auth.uid
          && isSameClass(resource.data.studentUid));
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isTeacher();
    }

    match /lessonPlans/{planId} {
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow read, update, delete: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    match /peerFeedbacks/{feedbackId} {
      allow create: if isStudent() && isValidPeerFeedback(request.resource.data);
      allow read: if isTeacher()
        || (request.auth != null && (
          resource.data.authorUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid
        ));
      allow delete: if isTeacher();
      allow update: if false;
    }

    function isValidGuidedQuestionSet(data) {
      return data.keys().hasAll([
          'teacherUid', 'templateId', 'templateName', 'topic', 'topicKey', 'questions', 'pinned', 'updatedAt'
        ])
        && data.teacherUid is string
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 64
        && data.templateName is string
        && data.topic is string
        && data.topic.size() > 0
        && data.topic.size() <= 200
        && data.topicKey is string
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 8
        && data.pinned is bool;
    }

    match /guidedQuestionSets/{setId} {
      allow read: if isTeacher()
        || (request.auth != null && resource.data.pinned == true);
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && isValidGuidedQuestionSet(request.resource.data);
      allow update: if isTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid
        && isValidGuidedQuestionSet(request.resource.data);
      allow delete: if isTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    function isValidBadgeDefinition(data) {
      return data.keys().hasAll(['label', 'iconKey', 'active', 'order'])
        && data.label is string && data.label.size() > 0 && data.label.size() <= 80
        && data.iconKey in ['shirt-green', 'shirt-blue', 'shirt-purple', 'shirt-amber', 'shirt-rose']
        && data.active is bool
        && data.order is number;
    }

    function isValidStudentBadge(data) {
      return data.keys().hasAll([
          'studentUid', 'studentName', 'grade', 'classNo', 'studentNo',
          'badgeId', 'badgeLabel', 'iconKey', 'awardedBy', 'awardedAt'
        ])
        && data.studentUid is string
        && data.badgeLabel is string
        && data.awardedBy is string
        && data.awardedBy == request.auth.uid
        && data.iconKey in ['shirt-green', 'shirt-blue', 'shirt-purple', 'shirt-amber', 'shirt-rose'];
    }

    match /badgeDefinitions/{badgeId} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher() && isValidBadgeDefinition(request.resource.data);
      allow delete: if isTeacher();
    }

    match /studentBadges/{awardId} {
      allow read: if isTeacher()
        || (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow create: if isTeacher() && isValidStudentBadge(request.resource.data);
      allow delete: if isTeacher();
      allow update: if false;
    }

    function isValidWorksheetContent(data) {
      return data.keys().hasAll(['templateId', 'fields', 'updatedBy', 'updatedAt'])
        && data.templateId is string
        && data.fields is map
        && data.fields.size() <= 120
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid;
    }

    match /worksheetContent/{templateId} {
      allow read: if request.auth != null;
      allow create, update: if isTeacher() && isValidWorksheetContent(request.resource.data);
      allow delete: if isTeacher();
    }

    match /inquiryReportShares/{shareId} {
      allow read: if true;
      allow create, update: if isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.reportId is string
        && request.resource.data.title is string;
      allow delete: if isTeacher() || (isStudent() && resource.data.studentUid == request.auth.uid);
    }

    function isValidTeacherInvite(data) {
      return data.keys().hasAll(['teacherUid', 'mode', 'templateId', 'templateName', 'label', 'active', 'updatedAt'])
        && data.teacherUid is string
        && data.mode in ['worksheet', 'report', 'workspace']
        && data.templateId is string
        && data.templateName is string
        && data.label is string
        && data.label.size() <= 200
        && data.active is bool;
    }

    match /teacherInvites/{token} {
      allow read: if true;
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && isValidTeacherInvite(request.resource.data);
      allow update: if isTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid
        && isValidTeacherInvite(request.resource.data);
      allow delete: if isTeacher() && resource.data.teacherUid == request.auth.uid;
    }

    function isTeacherOwner(data) {
      return request.auth != null
        && data.teacherUid is string
        && data.teacherUid == request.auth.uid
        && !isStudent();
    }

    function normalizeClassPart(value) {
      return value is string
        ? value.replace('학년', '').replace('반', '').trim()
        : '';
    }

    function isSameClassDoc(data) {
      return isStudent()
        && normalizeClassPart(studentData(request.auth.uid).grade) == normalizeClassPart(data.grade)
        && normalizeClassPart(studentData(request.auth.uid).classNo) == normalizeClassPart(data.classNo);
    }

    function isValidClassGroupPraise(data) {
      return data.keys().hasAll([
          'grade', 'classNo', 'studentNo', 'studentName', 'groupNo', 'weekIndex', 'primaryRoleCode', 'createdAt'
        ])
        && data.grade is string
        && data.classNo is string
        && data.studentNo is string
        && data.studentName is string
        && data.groupNo is number
        && data.weekIndex is number
        && data.primaryRoleCode in [1, 2, 3, 4];
    }

    match /groupRoleSchedules/{scheduleId} {
      allow read: if request.auth != null && (
        (isStudent() && resource.exists && isSameClassDoc(resource.data))
        || (!isStudent() && (
          !resource.exists
          || isTeacherOwner(resource.data)
          || isTeacher()
        ))
      );
      allow create: if isTeacherOwner(request.resource.data);
      allow update: if isTeacherOwner(resource.data) && isTeacherOwner(request.resource.data);
      allow delete: if isTeacherOwner(resource.data);
    }

    match /classGroupPraises/{praiseId} {
      allow read: if request.auth != null && (
        isTeacher() || (isStudent() && resource.exists && isSameClassDoc(resource.data))
      );
      allow create: if isTeacher() && isValidClassGroupPraise(request.resource.data);
      allow delete: if isTeacher();
      allow update: if false;
    }
  }
}
