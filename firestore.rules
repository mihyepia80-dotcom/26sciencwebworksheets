rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isStudent() {
      return request.auth != null
        && request.auth.token.email.matches('.*@sagodogu-student\\.app$');
    }

    function isValidSubmissionData(data) {
      return data.keys().hasAll(['templateId', 'templateName', 'meta', 'values', 'studentUid', 'submittedAt'])
        && data.templateId is string
        && data.templateId.size() > 0
        && data.templateId.size() <= 64
        && data.templateName is string
        && data.templateName.size() <= 120
        && data.meta is map
        && data.meta.size() <= 20
        && data.values is map
        && data.values.size() <= 200
        && data.studentUid is string
        && (!('aiFeedback' in data) || (data.aiFeedback is string && data.aiFeedback.size() <= 300))
        && (!('aiRating' in data) || data.aiRating in ['잘함', '보통', '노력요함']);
    }

    function isValidSubmissionCreate(data) {
      return isValidSubmissionData(data)
        && data.studentUid == request.auth.uid
        && data.submittedAt == request.time;
    }

    function isValidSubmissionUpdate() {
      return isValidSubmissionData(request.resource.data)
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.templateId == resource.data.templateId
        && request.resource.data.submittedAt == request.time;
    }

    match /teachers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /students/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && isStudent();
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow create: if isStudent() && isValidSubmissionCreate(request.resource.data);
      allow read: if isTeacher()
        || (request.auth != null && resource.data.studentUid == request.auth.uid);
      allow update: if isStudent()
        && resource.data.studentUid == request.auth.uid
        && isValidSubmissionUpdate();
      allow delete: if isTeacher();
    }
  }
}
